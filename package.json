{
  "name": "jom-laut",
  "version": "0.1.0",
  "private": true,
  "description": "Jom Laut — fishing trip & boat charter marketplace (modular monolith monorepo)",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false",
    "dev": "pnpm --filter @jom-laut/customer-web dev",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "typescript": "5.6.3",
    "vitest": "2.1.8",
    "fast-check": "3.23.1",
    "zod": "3.23.8"
  }
}
